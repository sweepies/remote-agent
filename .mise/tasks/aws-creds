#!/usr/bin/env nu
#MISE description="Mint short-lived AWS test-VM creds (K8s SA -> OpenBao -> STS); backing command for the fnox aws lease"
# aws-creds: mint short-lived AWS creds for the fnox `aws` lease.
#
# Flow: Kubernetes ServiceAccount token -> OpenBao K8s auth
#     -> OpenBao OIDC ID token -> STS AssumeRoleWithWebIdentity
#     -> temporary creds for arn:aws:iam::572707774253:role/remote-agent-test-vms
#
# Invoked as `mise run aws-creds` (the fnox lease create_command). Prints the
# fnox lease JSON on stdout; diagnostics go to stderr. Exits non-zero on any
# failure. Fails loudly, no stale fallback (Zach's convention).
#
# Env in:  FNOX_LEASE_DURATION (seconds; requested lease length)
#          FNOX_LEASE_LABEL (basis for the STS role session name)
#
# Secrets never touch argv: the SA token travels in the OpenBao login body,
# and the OIDC token reaches `aws sts` via a temp file.
#
# IMPORTANT: this script must never invoke mise (directly or via shims).
# mise evaluates task context on invocation, and this script runs inside
# `mise run`, so calling back into mise fork-bombs:
# mise -> script -> mise -> script ...
# Call tools as plain PATH lookups (mise puts the real tool bin dirs on the
# task's PATH). Shims are never used in this environment.

# --- config (single place for these values) ---
let openbao_url = "https://openbao.internal.maccrae.family"
let k8s_role = "remote-agent-aws"
let oidc_role = "remote-agent-aws"
let role_arn = "arn:aws:iam::572707774253:role/remote-agent-test-vms"
let region = "us-west-2"

# --- lease parameters from fnox ---
let requested_secs = ($env.FNOX_LEASE_DURATION? | default "3600" | into int)
# STS AssumeRoleWithWebIdentity takes 900s..43200s; the role's default max
# session duration is 3600s, so clamp there.
let duration_secs = if $requested_secs < 900 { 900 } else if $requested_secs > 3600 { 3600 } else { $requested_secs }
let session_name = ($env.FNOX_LEASE_LABEL?
  | default "fnox-lease"
  | str replace -r '[^a-zA-Z0-9_=,.@-]' '-'
  | str substring 0..63)

# --- ensure tooling is available ---
for tool in [curl aws] {
  if (which $tool | is-empty) {
    print --stderr $"aws-creds: required tool not on PATH: ($tool)"
    exit 1
  }
}

# --- step 1: read the mounted ServiceAccount token ---
let sa_token_path = "/var/run/secrets/kubernetes.io/serviceaccount/token"
if not ($sa_token_path | path exists) {
  print --stderr $"aws-creds: no ServiceAccount token at ($sa_token_path); not running in-cluster?"
  exit 1
}
let sa_token = (open $sa_token_path | str trim)
if ($sa_token | is-empty) {
  print --stderr "aws-creds: ServiceAccount token is empty"
  exit 1
}

# --- step 2: OpenBao K8s auth ---
# SA token travels in the JSON body, never in argv.
let login_body = { jwt: $sa_token, role: $k8s_role } | to json
let login_out = (do {
  $login_body | ^curl -fsS --max-time 20 -X POST -H "Content-Type: application/json" -d @- $"($openbao_url)/v1/auth/kubernetes/login"
} | complete)
if $login_out.exit_code != 0 {
  print --stderr $"aws-creds: OpenBao K8s login failed: ($login_out.stderr | str trim)"
  exit 1
}
let vault_token = try {
  $login_out.stdout | from json | get auth.client_token
} catch {
  print --stderr "aws-creds: OpenBao login response was not JSON with auth.client_token"
  exit 1
}
if ($vault_token | is-empty) {
  print --stderr "aws-creds: OpenBao returned an empty client token"
  exit 1
}

# --- step 3: OpenBao OIDC ID token for AWS ---
let oidc_out = (do {
  ^curl -fsS --max-time 20 -H $"X-Vault-Token: ($vault_token)" $"($openbao_url)/v1/identity/oidc/token/($oidc_role)"
} | complete)
if $oidc_out.exit_code != 0 {
  print --stderr $"aws-creds: OpenBao OIDC token request failed: ($oidc_out.stderr | str trim)"
  exit 1
}
let wid_token = try {
  $oidc_out.stdout | from json | get data.token
} catch {
  print --stderr "aws-creds: OpenBao OIDC response was not JSON with data.token"
  exit 1
}
if ($wid_token | is-empty) {
  print --stderr "aws-creds: OpenBao returned an empty OIDC token"
  exit 1
}
print --stderr "aws-creds: OpenBao OIDC token ok"

# --- step 4: STS AssumeRoleWithWebIdentity ---
# Pass the whole input as JSON via a temp file (0600 from mktemp) so the
# token never appears in argv.
let cli_input = {
  RoleArn: $role_arn,
  RoleSessionName: $session_name,
  DurationSeconds: $duration_secs,
  WebIdentityToken: $wid_token,
} | to json
let jsonfile = (mktemp)
$cli_input | save -f $jsonfile
let sts_out = (^aws sts assume-role-with-web-identity
  --cli-input-json $"file://($jsonfile)"
  --region $region
| complete)
rm -f $jsonfile
if $sts_out.exit_code != 0 {
  print --stderr $"aws-creds: STS AssumeRoleWithWebIdentity failed: ($sts_out.stderr | str trim)"
  exit 1
}
let creds = try {
  $sts_out.stdout | from json | get Credentials
} catch {
  print --stderr "aws-creds: STS response was not JSON with Credentials"
  exit 1
}

# --- fnox lease JSON on stdout ---
{
  credentials: {
    AWS_ACCESS_KEY_ID: ($creds.AccessKeyId),
    AWS_SECRET_ACCESS_KEY: ($creds.SecretAccessKey),
    AWS_SESSION_TOKEN: ($creds.SessionToken),
    AWS_REGION: $region,
    AWS_DEFAULT_REGION: $region,
  },
  expires_at: ($creds.Expiration),
  lease_id: $"aws-((date now) | format date '%Y%m%dT%H%M%S')",
} | to json
