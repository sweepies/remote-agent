{"$schema":"https://docs.renovatebot.com/renovate-schema.json","customManagers":[{"customType":"regex","datasourceTemplate":"github-releases","depNameTemplate":"pingdotgg/t3code","description":"T3 nightly pin in the Dockerfile","fileMatch":["^Dockerfile$"],"matchStrings":["ARG T3CODE_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+-nightly\\.\\d+\\.\\d+)"]}],"dependencyDashboard":true,"enabledManagers":["npm"],"extends":["config:best-practices"],"labels":["dependencies"],"packageRules":[{"allowedVersions":"/-nightly\\./","description":"T3 nightly: fresh PR every morning for Zach to merge himself; never batched (see event-github skill, liv:no-batch)","labels":["dependencies","liv:no-batch"],"matchDepNames":["pingdotgg/t3code"],"schedule":["0 4 * * *"]}],"prConcurrentLimit":0,"prHourlyLimit":0,"rangeStrategy":"pin","schedule":["before 5am on monday"],"semanticCommits":"enabled","timezone":"America/Vancouver"}