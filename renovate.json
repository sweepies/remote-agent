{"$schema": "https://docs.renovatebot.com/renovate-schema.json", "customManagers": [{
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "pingdotgg/t3code",
      "description": "T3 nightly pin in the Dockerfile",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": ["ARG T3CODE_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+-nightly\\.\\d+\\.\\d+)"]
    }], "dependencyDashboard": true, "enabledManagers": ["npm", "custom.regex"], "extends": ["config:best-practices"], "labels": ["dependencies"], "packageRules": [{"allowedVersions": "/-nightly\\./", "description": "T3 nightly: fresh PR whenever Renovate runs, for Zach to merge himself; never batched (see event-github skill, liv:no-batch)", "labels": ["dependencies", "liv:no-batch"], "matchDepNames": ["pingdotgg/t3code"]}], "prConcurrentLimit": 0, "prHourlyLimit": 0, "rangeStrategy": "pin", "semanticCommits": "enabled"}
