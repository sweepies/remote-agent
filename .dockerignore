# Keep the alchemy Docker context upload small (Railway `up` caps the
# archive at 32 MiB / 10,000 entries, no symlinks). Only files the
# Dockerfile COPYs matter; everything else is CI/infra scaffolding.
.git
.github
.alchemy
node_modules
bun.lock
alchemy.run.ts
package.json
tsconfig.json
scripts
*.md
.gitignore
.dockerignore
renovate.json
